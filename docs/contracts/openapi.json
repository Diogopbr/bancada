  "components": {
    "schemas": {
      "AccessRequest": {
        "required": [
          "expectedVersion"
        ],
        "type": "object",
        "properties": {
          "expectedVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateOrderRequest": {
        "required": [
          "customerName",
          "customerEmail",
          "equipmentLabel",
          "equipmentSerial",
          "reportedIssue",
          "technicianId"
        ],
        "type": "object",
        "properties": {
          "customerName": {
            "type": "string"
          },
          "customerEmail": {
            "type": "string"
          },
          "equipmentLabel": {
            "type": "string"
          },
          "equipmentSerial": {
            "type": [
              "null",
              "string"
            ]
          },
          "reportedIssue": {
            "type": "string"
          },
          "technicianId": {
            "type": "string"
          }
        }
      },
      "CustomerDecisionRequest": {
        "required": [
          "quoteRevision",
          "decision"
        ],
        "type": "object",
        "properties": {
          "quoteRevision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "decision": {
            "type": "string"
          }
        }
      },
      "CustomerSessionRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "DemoEmptyRequest": {
        "type": "object"
      },
      "DemoRoleRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          }
        }
      },
      "DiagnosisRequest": {
        "required": [
          "expectedVersion",
          "diagnosis"
        ],
        "type": "object",
        "properties": {
          "expectedVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "diagnosis": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "PublishQuoteRequest": {
        "required": [
          "expectedVersion",
          "items"
        ],
        "type": "object",
        "properties": {
          "expectedVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "items": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/QuoteItemRequest"
            }
          }
        }
      },
      "QuoteItemRequest": {
        "required": [
          "description",
          "kind",
          "quantity",
          "unitPrice"
        ],
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "unitPrice": {
            "type": "string"
          }
        }
      },
      "TransitionRequest": {
        "required": [
          "expectedVersion",
          "target",
          "reason"
        ],
        "type": "object",
        "properties": {
          "expectedVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "target": {
            "type": "string"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
